#
# NetHack 3.6.7 hints: tty + "bot" structured window port, local prefix.
# Used by engine/build.sh (PREFIX is passed on the make command line).
#
#-PRE

PREFIX=$(BOTPREFIX)
HACKDIR=$(PREFIX)/nhdir
SHELLDIR = $(PREFIX)/bin
INSTDIR=$(HACKDIR)
VARDIR = $(HACKDIR)

POSTINSTALL=cp -n sys/unix/sysconf $(INSTDIR)/sysconf; chmod $(VARFILEPERM) $(INSTDIR)/sysconf;

CFLAGS=-g -O2 -I../include -DNOTPARMDECL
CFLAGS+=-DDLB
CFLAGS+=-DSYSCF -DSYSCF_FILE=\"sysconf\"
CFLAGS+=-DHACKDIR=\"$(HACKDIR)\"
CFLAGS+=-DDUMPLOG
CFLAGS+=-DCONFIG_ERROR_SECURE=FALSE
CFLAGS+=-DBOT_GRAPHICS
CFLAGS+=-Wno-format-truncation

LINK=$(CC)
LFLAGS=-rdynamic

WINSRC = $(WINTTYSRC) ../win/bot/winbot.c
WINOBJ = $(WINTTYOBJ) winbot.o
WINLIB = $(WINTTYLIB)

WINTTYLIB=-lncurses -ltinfo

CHOWN=true
CHGRP=true

VARDIRPERM = 0755
VARFILEPERM = 0644
GAMEPERM = 0755
