#
# NetHack 3.6.7 hints: headless build, "bot" window port only (no tty, no ncurses).
# Used by engine/build.sh (PREFIX is passed on the make command line).
#
#-PRE

PREFIX=$(BOTPREFIX)
HACKDIR=$(PREFIX)/nhdir
SHELLDIR = $(PREFIX)/bin
INSTDIR=$(HACKDIR)
VARDIR = $(HACKDIR)

POSTINSTALL=cp -n sys/unix/sysconf $(INSTDIR)/sysconf; chmod $(VARFILEPERM) $(INSTDIR)/sysconf;

CFLAGS=-g -O2 -I../include -DNOTPARMDECL
CFLAGS+=-DDLB
CFLAGS+=-DSYSCF -DSYSCF_FILE=\"sysconf\"
CFLAGS+=-DHACKDIR=\"$(HACKDIR)\"
CFLAGS+=-DDUMPLOG
CFLAGS+=-DCONFIG_ERROR_SECURE=FALSE
CFLAGS+=-DBOT_GRAPHICS -DBOT_HEADLESS -DDEFAULT_WINDOW_SYS=\"bot\"
CFLAGS+=-Wno-format-truncation

LINK=$(CC)
LFLAGS=-rdynamic

WINSRC = ../win/bot/winbot.c
WINOBJ = winbot.o
WINLIB =

WINTTYLIB=

CHOWN=true
CHGRP=true

VARDIRPERM = 0755
VARFILEPERM = 0644
GAMEPERM = 0755
