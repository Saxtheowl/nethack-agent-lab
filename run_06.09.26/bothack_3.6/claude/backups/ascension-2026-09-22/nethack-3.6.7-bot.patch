+char
+bot_yn_function(query, resp, def)
+const char *query, *resp;
+char def;
+{
+    struct sbuf sb = { 0, 0, 0 };
+    const char *reply;
+    char q = 0;
+    char dstr[2];
+
+    yn_number = 0L;
+    sb_add(&sb, "\"query\":");
+    sb_str(&sb, query ? query : "");
+    sb_add(&sb, ",\"choices\":");
+    if (resp)
+        sb_str(&sb, resp);
+    else
+        sb_add(&sb, "null");
+    dstr[0] = def;
+    dstr[1] = '\0';
+    sb_add(&sb, ",\"default\":");
+    sb_str(&sb, dstr);
+    reply = bot_request("yn", sb.s);
+    sb_free(&sb);
+
+    if (reply[0] == 'e' && (!reply[1] || reply[1] == ' ')) {
+        q = '\033';
+    } else if (reply[0] == 'y' && reply[1] == ' ') {
+        char *endp;
+        long v = strtol(reply + 2, &endp, 10);
+
+        q = (v > 0 && v < 256) ? (char) v : '\033';
+        if (*endp == ' ')
+            yn_number = atol(endp + 1);
+    } else {
+        ev_protoerr("yn", reply);
+        q = '\033';
+    }
+    if (!resp)
+        return q;
+    if (q == '\033') {
+        if (index(resp, 'q'))
+            return 'q';
+        if (index(resp, 'n'))
+            return 'n';
+        return def;
+    }
+    if (index(quitchars, q))
+        return def;
+    if (q == '#' && index(resp, '#'))
+        return '#';
+    if (!index(resp, q)) {
+        ev_protoerr("yn-choice", reply);
+        if (index(resp, 'q'))
+            return 'q';
+        if (index(resp, 'n'))
+            return 'n';
+        return def;
+    }
+    return q;
+}
