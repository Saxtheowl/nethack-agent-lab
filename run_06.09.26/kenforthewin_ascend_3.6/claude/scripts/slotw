#!/bin/bash
# slots/N/w <command...>: run one of YOUR OWN helpers (files in slots/N/) next
# to the game: on the worker when the slot lives there (slots/N is copied up
# first and copied back after), else here. Runs inside slots/N.
# -tt: killing the local caller also stops the remote helper (SIGHUP).
R="$(cd "$(dirname "$0")/.." && pwd -P)"
N=${NH_SLOT:?}
if [ "${NH_HOST:-}" != worker ] && [ "$(cat "$R/.runtime/where-$N" 2>/dev/null)" = worker ]; then
  SSH="ssh -o BatchMode=yes -o ControlMaster=auto -o ControlPath=/tmp/ssh-nh-%C -o ControlPersist=900"
  rsync -az -e "$SSH" --exclude __pycache__ "$R/slots/$N/" "miniforum-worker:$R/slots/$N/"
  $SSH -tt -o LogLevel=QUIET miniforum-worker "stty -echo -onlcr 2>/dev/null; cd $R/slots/$N && NH_HOST=worker NH_SLOT=$N $(printf '%q ' "$@")" </dev/null > >(tr -d '\r') &
  pid=$!
  trap 'kill $pid 2>/dev/null' TERM INT HUP
  wait $pid; rc=$?
  wait
  rsync -az -e "$SSH" --exclude __pycache__ "miniforum-worker:$R/slots/$N/" "$R/slots/$N/"
  exit $rc
fi
cd "$R/slots/$N" && exec "$@"
