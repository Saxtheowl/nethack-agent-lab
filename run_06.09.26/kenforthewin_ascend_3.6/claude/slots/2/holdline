#!/bin/bash
# slot2: hold a corridor facing dir D; hit whatever is at D, search otherwise. Stops: HP<min, stole,
# monster adjacent in another direction, nothing for 6 searches, or N actions. usage: holdline D [N] [minHP]
cd "$(dirname "$0")"; D=$1; N=${2:-20}; MIN=${3:-60}; idle=0
for i in $(seq $N); do
  s=$(./v); cur=$(echo "$s" | head -1 | grep -oE '[0-9]+,[0-9]+$'); nb=$(echo "$s" | grep "^Neighbors of @($cur)")
  hp=$(echo "$s" | grep -o 'HP:[0-9]*' | head -1 | cut -d: -f2)
  [ "$hp" -lt "$MIN" ] && { echo "LOWHP $hp"; exit 3; }
  echo "$s" | grep -qiE 'stole|snatch' && { echo STOLE; exit 2; }
  other=$(echo "$nb" | grep -oE '[1-9]:[a-zA-Z@&;:]\(' | grep -v "^$D:")
  [ -n "$other" ] && { echo "OTHER $other"; echo "$nb"; exit 4; }
  echo "$s" | grep -qiE 'slowing down|stiffening|limbs' && { echo STONING; exit 6; }
  echo "$nb" | grep -qE "$D:[eAF]\(" && { echo "SPECIAL $(echo "$nb" | grep -oE "$D:.\(")"; exit 7; }
  if echo "$nb" | grep -qE "$D:[a-zA-Z@&;:]\("; then
    o=$(./k --raw F$D); echo "$o" | grep -E '^07' | tr -s ' '; idle=0
  else
    idle=$((idle+1)); [ $idle -gt 6 ] && { echo IDLE; break; }
    ./k --raw s >/dev/null
  fi
done
./v | grep -E '^34|^Neigh'
