#!/bin/bash
# slot2: advance in dir $1 up to N steps ($2); before each step kill every adjacent letter monster (one blow at a time). stop HP<$3
cd "$(dirname "$0")"; D=$1; N=${2:-5}; MIN=${3:-80}
for s in $(seq $N); do
  for j in $(seq 12); do
    v=$(./v); c=$(echo "$v" | head -1 | grep -o '[0-9]*,[0-9]*$'); n=$(echo "$v" | grep "^Neighbors of @($c)")
    hp=$(echo "$v" | grep -o 'HP:[0-9]*' | head -1 | cut -d: -f2); [ "$hp" -lt "$MIN" ] && { echo "LOWHP $hp"; exit 3; }
    echo "$v" | grep -qE 'Really attack|\[yn' && { echo PROMPT; exit 5; }
    d=$(echo "$n" | grep -oE "[1-9]:[a-zA-Z&;:]\(" | head -1 | cut -c1); [ -z "$d" ] && break
    ./hit $d $MIN | grep -E '^07|^34|STOLE|LOWHP' | tr -s ' '; [ ${PIPESTATUS[0]} -ne 0 ] && exit 2
  done
  o=$(./k --raw $D); echo "$o" | grep -E '^07' | tr -s ' '
  echo "$o" | grep -qiE 'stole|Really attack|\[yn' && { echo "STOP special"; exit 4; }
done
./v | grep -E '^34|^Neigh'
