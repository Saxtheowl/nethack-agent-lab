#!/bin/bash
# slots/4/dfs [steps] [prefdirs] : depth-first walk of dark areas using the Neighbors line.
# Moves to unvisited walkable neighbours (preference order prefdirs, default 6392874 1), backtracks along its own path.
# Stops on: non-pet monster adjacent (letters/@), HP loss, prompt, item seen underfoot is reported but not picked.
# State (visited) kept in .runtime-free file slots/4/.dfs-<dlvl>.json so repeated calls continue.
cd "$(dirname "$0")/../.."
export NH_SLOT=4
python3 - "${1:-40}" "${2:-63982147}" <<'PY'
import sys, re, subprocess, json, os
n=int(sys.argv[1]); pref=sys.argv[2]
off={'8':(0,-1),'6':(1,0),'2':(0,1),'4':(-1,0),'9':(1,-1),'3':(1,1),'1':(-1,1),'7':(-1,-1)}
def scr(): return subprocess.run(['python3','scripts/session.py','screen','--compact'],capture_output=True,text=True).stdout
def send(k): return subprocess.run(['python3','scripts/session.py','keys','--compact','--raw',k],capture_output=True,text=True).stdout
s=scr()
lvl=re.search(r'Dlvl:(\d+)',s)[1]
f=f'slots/4/.dfs-{lvl}.json'
try: st=json.load(open(f))
except Exception: st={'visited':[],'stack':[]}
visited=set(map(tuple,st['visited'])); stack=[tuple(p) for p in st['stack']]
hp0=int(re.search(r'HP:(\d+)',s)[1])
pets=set()
msg=''
for i in range(n):
    c=re.search(r'Terminal cursor \(x,y; usually hero when no menu\): (\d+),(\d+)',s)
    m=re.search(r'Neighbors of @\(%s,%s\): (.*)'%(c[1],c[2]),s) if c else None
    if not m: m=re.search(r'Neighbors of @\((\d+),(\d+)\): (.*)',s)
    m=[None,*re.match(r'Neighbors of @\((\d+),(\d+)\): (.*)',m[0]).groups()]
    cur=(int(m[1]),int(m[2])); visited.add(cur)
    pl=re.search(r'^PETS.*$',s,re.M); pets=set(re.findall(r'(\d+),(\d+)',pl[0])) if pl else set()
    nb={}
    for d,g,a,b in re.findall(r'(\d):(\S+?)\((\d+),(\d+)\)',m[3]): nb[d]=(g,(int(a),int(b)))
    mon=[(d,g) for d,(g,p) in nb.items() if (g[0].isalpha() and g!='blank') or g in ('&',"'",';',':')]
    mon=[x for x in mon if x[1] not in os.environ.get('DFS_IGNORE','')]
    mon=[x for x in mon if (str(nb[x[0]][1][0]),str(nb[x[0]][1][1])) not in pets]
    if mon: msg=f'STOP monster adjacent {mon}'; break
    mv=None
    for d in pref:
        if d not in nb: continue
        g,p=nb[d]
        if p in visited: continue
        if g in ('·','.','▒','#','<','>','{','_','%','$','!','?','=','"','(',')','[','*','/','+','|','-') :
            if g in ('|','-','+') : 
                if d in '1379': continue
            if g=='+': continue
            mv=d; break
    if mv:
        stack.append(cur) if (not stack or stack[-1]!=cur) else None
        s=send(mv)
    else:
        if not stack: msg='STOP fully explored'; break
        back=stack.pop()
        d=[k for k,v in off.items() if (cur[0]+v[0],cur[1]+v[1])==back]
        if not d: msg='STOP cannot backtrack'; break
        s=send(d[0])
    if 'Really attack' in s: send('n'); msg='STOP peaceful in the way'; break
    if re.search(r'--More--|\[yn', '\n'.join(l for l in s.splitlines() if re.match(r'^0[1-7] ',l))[-200:]): msg='STOP prompt'; break
    hp=int(re.search(r'HP:(\d+)',s)[1])
    if hp<hp0: msg='STOP HP loss'; break
json.dump({'visited':sorted(visited),'stack':stack},open(f,'w'))
print(msg or 'steps done')
PY
python3 scripts/session.py screen --compact | grep -E '^0[5-7] |^34|^Map'
