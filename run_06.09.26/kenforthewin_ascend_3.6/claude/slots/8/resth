#!/bin/bash
# slots/8/rest1 [target%] [maxturns]: search ONE turn at a time (s) with an HP/status/neighbour check after each.
# Stops on HP drop, adjacent non-pet monster, bad status (Stone/Slime/Weak/...), theft, prompt. Run via slots/8/w.
cd "$(dirname "$0")/../.."
export NH_SLOT=8
t=${1:-85}; n=${2:-150}; prev=999
for i in $(seq $n); do
  o=$(python3 scripts/session.py keys --compact --why "rest 1 turn" s 2>&1)
  echo "$o" | grep -q "HP ALARM\|refused" && { echo "STOP: guard refused"; break; }
  hp=$(echo "$o" | grep -o 'HP:[0-9]*([0-9]*)' | head -1); cur=${hp#HP:}; cur=${cur%%(*}; mx=${hp#*(}; mx=${mx%)}
  [ -z "$cur" ] && { echo "no HP read"; break; }
  [ $cur -lt $prev ] && [ $prev -ne 999 ] && { echo "STOP: HP dropped $cur"; break; }
  prev=$cur
  echo "$o" | grep -E "^34" | grep -qE "Hungry|Weak|Faint|Blind|Conf|Stun|Ill|Stone|Slime" && { echo "STOP: status"; break; }
  echo "$o" | grep -E "^07" | grep -qiE "stole|steal|--More--|\[yn" && { echo "STOP: message/prompt"; break; }
  pets=$(echo "$o" | grep '^PETS')
  for a in $(echo "$o" | grep '^Neighbors' | grep -oE "[0-9]:[A-Za-z&;:'@]\([0-9]+,[0-9]+\)"); do
    xy=$(echo "$a" | grep -oE "[0-9]+,[0-9]+"); echo "$pets" | grep -q "$xy" || { echo "STOP: adjacent $a"; break 2; }
  done
  echo "$o" | grep -E "^34" | grep -q Hallu || { echo "Hallu over"; break; }
done
python3 scripts/session.py screen --compact | grep -E "^0[67] |^34"
