#!/bin/bash
# slots/8/srest TARGET% [max] (run via slots/8/w ./srest 70 200): single-turn searches ('s', one
# command each, allowed under 70% HP) until HP >= TARGET%. Stops on any HP drop, adjacent
# non-pet monster, status change, theft/prompt message.
cd "$(dirname "$0")/../.."
export NH_SLOT=8
t=${1:-70}; n=${2:-150}; prev=999
norm() { grep '^34' | sed -E 's/(T|HP|Pw|Xp|\$):[^ ]*//g; s/ +/ /g'; }
st0=$(python3 scripts/session.py screen --compact | norm)
m0=$(python3 scripts/session.py screen --compact | grep -E "^07 ")
for i in $(seq "$n"); do
  s=$(python3 scripts/session.py keys --compact --why "rest one turn" s 2>&1)
  hp=$(echo "$s" | grep -o 'HP:[0-9]*([0-9]*)' | head -1); cur=${hp#HP:}; cur=${cur%%(*}; mx=${hp#*(}; mx=${mx%)}
  [ -z "$cur" ] && { echo "STOP: no status: $(echo "$s" | tail -1)"; break; }
  [ "$prev" != 999 ] && [ "$cur" -lt "$prev" ] && { echo "STOP: HP dropped to $cur"; break; }
  prev=$cur
  [ "$(echo "$s" | norm)" != "$st0" ] && { echo "STOP: status changed"; break; }
  l7=$(echo "$s" | grep -E "^07 "); [ "$l7" != "$m0" ] && echo "$l7" | grep -qiE "stole|steal|--More--|\[yn|swings itself|engulf|Search for" && { echo "STOP: message"; break; }
  pets=$(echo "$s" | grep '^PETS' | grep -o '[0-9]*,[0-9]*' | tr '\n' ' ')
  adj=$(echo "$s" | grep '^Neighbors' | grep -oE "[1-9]:[A-Za-z@&;:'][(][0-9]+,[0-9]+[)]" | while read c; do xy=${c#*(}; xy=${xy%)}; [[ " $pets " == *" $xy "* ]] || echo "$c"; done)
  [ -n "$adj" ] && { echo "STOP: adjacent $adj"; break; }
  [ $((cur * 100)) -ge $((mx * t)) ] && { echo "OK HP $cur/$mx"; break; }
done
python3 scripts/session.py screen --compact | grep -E '^0[67] |^34'
