#!/bin/bash
# camp2 N: like camp, but also fights adjacent '@' ONLY if the farlook name inside (...) is
# exactly one of: elf-lord Elvenking Woodland-elf Green-elf Grey-elf (never priest/peaceful/shk/watch).
# Stops after a kill (to sacrifice/eat), on HP < 70% max, Weak/Hungry, stolen, or prompt.
D="$(dirname "$0")"
me() { c=$(echo "$1" | grep -o 'cursor[^:]*: [0-9]*,[0-9]*' | grep -o '[0-9]*,[0-9]*$'); echo "$1" | grep "^Neighbors of @($c)" | head -1; }
o=$($D/v); max=$(echo "$o" | grep -oE 'HP:[0-9]+\([0-9]+' | head -1 | cut -d'(' -f2)
for r in $(seq "$1"); do
  o=$($D/k n20s --raw)
  for f in $(seq 12); do
    echo "$o" | grep -q -- '--More--' && o=$($D/k --named Enter --raw)
    hp=$(echo "$o" | grep -oE 'HP:[0-9]+' | head -1 | cut -d: -f2); [ -z "$hp" ] && hp=$($D/v | grep -oE "HP:[0-9]+" | head -1 | cut -d: -f2)
    [ "$hp" -lt $((max * 7 / 10)) ] && { echo "LOW HP $hp"; echo "$o" | grep -E '^0[5-7]|^34'; exit 1; }
    echo "$o" | grep '^34' | grep -qE ' (Weak|Fainting|Faint)' && { echo HUNGER; exit 1; }
    echo "$o" | grep -qiE 'stole|steals|Really attack|Stiff|slowing down|confuses you|more and more confused' && { echo "ALERT"; echo "$o" | grep -E '^0[5-7]'; exit 1; }
    echo "$o" | grep '^34' | grep -qE ' (Blind|Conf|Stun)' && { echo "STATUS"; echo "$o" | grep -E '^0[5-7]|^34'; exit 1; }
    n=$(me "$o"); d=""; xy=""
    echo "$n" | grep -q "7:/(" && echo "$n" | grep -q "3:/(" && { echo ENGULFED; exit 1; }
    for cand in $(echo "$n" | LC_ALL=C grep -oE "[1-9]:[A-HJ-Za-z&;:'@][(][0-9]+,[0-9]+"); do
      cd_=${cand%%:*}; cxy=$(echo "$cand" | grep -oE '[0-9]+,[0-9]+'); ch=$(echo "$cand" | cut -c3)
      l=$($D/look ${cxy%,*} ${cxy#*,} | head -1 | head -c 120)
      echo "$l" | grep -qiE 'peaceful|priest|shopkeeper|watch|tame' && continue
      if [ "$ch" = "@" ]; then echo "$l" | grep -qE '\((elf-lord|Elvenking|Woodland-elf|Green-elf|Grey-elf|soldier|sergeant|lieutenant|captain)\)' || continue; fi
      d=$cd_; xy=$cxy; break
    done
    [ -z "$d" ] && break
    o=$($D/k F$d --raw)
    echo "$o" | grep -q 'Really attack' && { $D/k --named Escape --raw >/dev/null; echo PEACEFUL-ABORT; exit 1; }
    m=$(echo "$o" | grep -E '^0[5-7]' | tr -s ' ' | tail -2 | tr '\n' ' ')
    echo "[$d] HP$(echo "$o" | grep -oE 'HP:[0-9]+' | head -1 | cut -d: -f2) $m" | cut -c1-150
    echo "$o" | grep -qE 'You kill|You destroy' && { echo KILLED; exit 0; }
  done
done
echo "quiet T$(echo "$o" | grep -oE 'T:[0-9]+' | head -1)"
