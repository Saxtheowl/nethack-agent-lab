#!/bin/bash
# trav KEY TX TY [n]: raw travel with _ KEY . (KEY '<' or '>' or '_' for last travel dest), until cursor==TX,TY; stops on HP drop.
cd "$(dirname "$0")/../.."
h0=""
for i in $(seq "${4:-8}"); do
  slots/7/k _ --raw >/dev/null; for ((j=0;j<${#1};j++)); do slots/7/k "${1:$j:1}" --raw >/dev/null; done; o=$(slots/7/k . --raw)
  c=$(echo "$o" | grep -o 'cursor[^:]*: [0-9]*,[0-9]*' | grep -o '[0-9]*,[0-9]*$'); hp=$(echo "$o" | grep -o 'HP:[0-9]*' | head -1 | cut -d: -f2)
  echo "$c HP$hp $(echo "$o" | grep -E '^07' | tr -s ' ')"
  [ "$c" == "$2,$3" ] && exit 0
  [ -n "$h0" ] && [ "$hp" -lt "$h0" ] && { echo "HP DROP"; exit 1; }
  h0=$hp
done
exit 1
