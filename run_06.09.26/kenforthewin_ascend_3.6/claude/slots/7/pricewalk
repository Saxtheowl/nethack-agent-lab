#!/bin/bash
# pricewalk MOVES...: one step per move, print the newest "You see here/There are" line and position
D="$(dirname "$0")"
for m in "$@"; do
  # SAFETY (death T6178): refuse to step onto a square showing a monster/unknown glyph
  nb=$($D/v | grep "^Neighbors" | head -1)
  tgt=$(echo "$nb" | grep -oE " $m:[^(]*" | cut -d: -f2)
  echo "$tgt" | LC_ALL=C grep -qE "^[A-Za-z@&;:'I1-5]$" && { echo "STOP: monster '$tgt' in direction $m"; break; }
  o=$($D/k $m 2>&1)
  last=$(echo "$o" | grep -E "^0[0-9]" | tail -1)
  echo "$last" | grep -q "Really attack" && { $D/k --named Escape >/dev/null; echo "PEACEFUL in the way"; break; }
  c=$(echo "$o" | grep -o 'cursor[^:]*: [0-9]*,[0-9]*' | grep -o '[0-9]*,[0-9]*$')
  msg=$(echo "$o" | grep -E "^0[0-9]" | tail -2 | grep -oE "(You see here|There are|Things that).*" | sed 's/ *│.*//' | tail -1)
  echo "[$m] $c $msg"
  echo "$o" | grep -q "HP ALARM" && break
done
