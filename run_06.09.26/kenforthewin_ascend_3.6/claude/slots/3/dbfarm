#!/bin/bash
# slots/3/dbfarm [CYCLES] [WAIT] [MINHP%]: Castle drawbridge crusher. Stand on a verified Elbereth at (13,21)
# (screen) next to the drawbridge (14,21) / portcullis (15,21). Each cycle: open the bridge with the passtune,
# wait up to WAIT single turns until a monster stands on (14,21) or (15,21), then play again to close it
# (crushes/drowns them, XP to me). Closes the bridge before stopping. Stops on: HP < MINHP% (default 70),
# HP loss >= 15 in one turn, Elbereth gone, a monster letter on (13,20)/(13,22)/(12,x) (inside the
# courtyard next to me), stole/engulf/--More--, @ not at 13,21. Run via slots/3/w ./dbfarm
cd "$(dirname "$0")"
C=${1:-3}; W=${2:-8}; MINHP=${3:-70}
state() { s=$(./v); me=$(echo "$s" | grep -o 'Terminal cursor[^:]*: [0-9]*,[0-9]*' | grep -o '[0-9]*,[0-9]*$');
  hp=$(echo "$s" | grep -oE 'HP:[0-9]+\([0-9]+\)' | head -1); cur=${hp#HP:}; cur=${cur%%(*}; mx=${hp#*(}; mx=${mx%)};
  mf=$(echo "$s" | grep '^Map'); }
bstate() { ./v | python3 -c 'import sys
for l in sys.stdin:
    if l.startswith("21 "): print(l[3+14])'; }   # glyph at screen (14,21): } = raised
bridge_occ() { echo "$mf" | grep -oE " [A-Za-z;:&'@]@1[45],21" | tr -d ' '; }
inner() { echo "$mf" | grep -oE " [A-XZa-np-z&'@:]@(1[23],(2[0-2])|1[23],19|1[23],23)" | grep -v "@13,21" | tr -d ' '; }
cure() { for t in 1 2 3 4 5; do st=$(./v | grep -E '^34' | grep -oE 'Conf|Stun|Hallu'); [ -z "$st" ] && return 0;
  echo "status $st: unicorn horn"; ./k --why "unicorn horn: cure $st to play the passtune" ag >/dev/null; done; return 1; }
check() { # returns nonzero to stop
  cure || { echo "STOP: cannot cure confusion/stun"; return 1; }
  state
  [ "$me" != "13,21" ] && { echo "STOP: not at 13,21 ($me)"; return 1; }
  [ $((cur*100)) -lt $((mx*MINHP)) ] && { echo "STOP: HP $cur/$mx"; return 1; }
  [ -n "$last" ] && [ $((last-cur)) -ge 15 ] && { echo "STOP: big HP loss $last -> $cur"; return 1; }
  last=$cur
  echo "$s" | grep -E '^0[1-7] ' | tail -3 | grep -qiE 'stole|seduce|engulf|swallow|--More--' && { echo "STOP: message"; return 1; }
  i=$(inner); [ -n "$i" ] && { echo "STOP: monster inside the courtyard next to me: $i"; return 1; }
  return 0
}
elb() { ./k --why "check Elbereth" : >/dev/null; o=$(./k --named Escape); echo "$o" | grep -E '^0[1-7] ' | grep 'You read:' | tail -1 | grep -q 'You read: "Elbereth"'; }
last=""
check || exit 1
elb || { ./reelb | grep -q OK || { echo "STOP: Elbereth not intact"; exit 1; }; }
for c in $(seq "$C"); do
  o=$(./tune PASS); echo "open: $(echo "$o" | grep -oE 'drawbridge [a-z]+ (down|up)|You kill[^!]*!|crushed[^!]*!' | tr '\n' ' ')"
  b=$(bstate); [ "$b" = "}" ] && { echo "STOP: bridge did not open ($b)"; echo "$o"; exit 1; }
  killed=""
  for w in $(seq "$W"); do
    check || { ./tune PASS | grep -oE 'You kill[^!]*!|crushed[^!]*!|drawbridge [a-z]+ up' ; exit 1; }
    occ=$(bridge_occ)
    pk=""; for o1 in $occ; do xy=${o1##*@}; lk=$(./look ${xy%,*} ${xy#*,}); echo "$lk" | grep -q peaceful && pk="$pk $o1"; done
    if [ -n "$pk" ]; then echo "peaceful on the bridge:$pk (waiting)"; occ=""; fi
    if [ -n "$occ" ]; then
      o=$(./tune PASS); echo "close on $occ: $(echo "$o" | grep -oE 'You kill[^!]*!|crushed[^!]*!|falls? into[^.]*\.|passes through[^!]*!|drawbridge [a-z]+ up|disappears? behind[^.]*\.' | tr '\n' ' ')"
      killed=1; break
    fi
    ./k --why "wait for monsters on the bridge" s >/dev/null
  done
  if [ -z "$killed" ]; then
    for w2 in $(seq 10); do state; pk=""; for o1 in $(bridge_occ); do xy=${o1##*@}; ./look ${xy%,*} ${xy#*,} | grep -q peaceful && pk=1; done
      [ -z "$pk" ] && break; ./k --why "peaceful on the bridge: wait" s >/dev/null; done
    [ -n "$pk" ] && { echo "STOP: a peaceful stays on the bridge (bridge OPEN)"; exit 1; }
    o=$(./tune PASS); echo "close (timeout): $(echo "$o" | grep -oE 'You kill[^!]*!|drawbridge [a-z]+ up' | tr '\n' ' ')"; fi
  check || exit 1
  elb || { echo "Elbereth worn: rewriting"; ./reelb | grep -q OK || { echo "STOP: Elbereth not intact"; exit 1; }; }
done
state; echo "$s" | grep -E '^34' | grep -oE 'HP:.*T:[0-9]+'
