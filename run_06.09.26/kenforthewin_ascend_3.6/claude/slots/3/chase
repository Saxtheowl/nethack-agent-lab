#!/bin/bash
# chase GLYPH [N]: step toward the nearest visible monster GLYPH and attack it when adjacent (F). No '@'/'e'.
# Stops on kill, glyph gone, HP < 55%, ALARM.
cd "$(dirname "$0")"
g=$1; n=${2:-12}
declare -A D=([-1,-1]=7 [0,-1]=8 [1,-1]=9 [-1,0]=4 [1,0]=6 [-1,1]=1 [0,1]=2 [1,1]=3)
for i in $(seq $n); do
  ./k --named Escape >/dev/null 2>&1
  s=$(./v)
  hp=$(echo "$s" | grep -o 'HP:[0-9]*([0-9]*)' | head -1); cur=${hp#HP:}; cur=${cur%%(*}; max=${hp#*(}; max=${max%)}
  [ $((cur * 100)) -lt $((max * 55)) ] && { echo "LOW HP $cur"; break; }
  pos=$(echo "$s" | grep -oE 'Terminal cursor[^:]*: [0-9]+,[0-9]+' | grep -oE '[0-9]+,[0-9]+'); hx=${pos%,*}; hy=${pos#*,}
  best=""; bd=999
  for m in $(echo "$s" | grep '^Map features' | grep -oE " [$g]@[0-9]+,[0-9]+"); do c=${m#*@}; x=${c%,*}; y=${c#*,}; dx=$((x-hx)); dy=$((y-hy)); d=$(( ${dx#-} > ${dy#-} ? ${dx#-} : ${dy#-} )); [ $d -lt $bd ] && { bd=$d; best="$x $y"; }; done
  [ -z "$best" ] && { echo "$g not visible"; break; }
  set -- $best; dx=$(($1-hx)); dy=$(($2-hy)); sx=$(( dx>0?1:(dx<0?-1:0) )); sy=$(( dy>0?1:(dy<0?-1:0) )); d=${D[$sx,$sy]}
  if [ $bd -le 1 ]; then o=$(./k F$d --raw 2>&1); else o=$(./k $d 2>&1); fi
  echo "$o" | grep -q ALARM && { echo ALARM; break; }
  m=$(echo "$o" | grep -E '^0[1-9]' | tail -1 | cut -c5-70); echo "[$bd $d] $m"
  echo "$m" | grep -qE 'You kill|You destroy' && break
  g=${g}
done
