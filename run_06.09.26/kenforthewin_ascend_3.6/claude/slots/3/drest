#!/bin/bash
# slots/3/drest N [IGNORE]: N single searches (1 turn each). IGNORE = space-separated "x,y" squares whose
# glyph is a statue (never treated as a monster). Stops on HP loss, status change, prompt/--More--,
# steal/engulf/seduce messages, or any non-pet monster letter ADJACENT (except ignored squares).
# Run via slots/3/w ./drest
cd "$(dirname "$0")/../.."
export NH_SLOT=3
S="python3 scripts/session.py"
n=${1:-10}; ign="${2:-}"
prev=""
for i in $(seq "$n"); do
  out=$($S keys --compact s 2>&1)
  hp=$(echo "$out" | grep -o 'HP:[0-9]*' | head -1 | cut -d: -f2)
  st=$(echo "$out" | grep -E '^34 ' | grep -oE 'Hungry|Weak|Fainting|Stone|Slime|Blind|Conf|Stun|Ill|FoodPois|Hallu')
  if [ -n "$prev" ] && [ "$hp" -lt "$prev" ]; then echo "STOP: HP loss $prev -> $hp"; break; fi
  prev=$hp
  [ -n "$st" ] && { echo "STOP: status $st"; break; }
  cy=$(echo "$out" | grep -o 'Terminal cursor[^:]*: [0-9]*,[0-9]*' | grep -o '[0-9]*$')
  [ "${cy:-0}" -lt 10 ] && { echo "STOP: prompt (cursor row $cy)"; break; }
  echo "$out" | grep -E '^0[1-7] ' | tail -3 | grep -qiE 'stole|steal|seduc|engulf|swallow|--More--|>>' && { echo "STOP: message"; break; }
  adj=$(echo "$out" | IGN="$ign" python3 -c '
import re,sys,os
t=sys.stdin.read()
ign=set(os.environ.get("IGN","").split())
n=re.search(r"^Neighbors of @\((\d+),(\d+)\): (.*)$",t,re.M)
pm=re.search(r"^PETS.*$",t,re.M); pets=pm.group(0) if pm else ""
bad=[]
for k,c,x,y in re.findall(r"(\d):(.)\((\d+),(\d+)\)",n.group(3)):
    if (c.isalpha() or c in "@&;:\x27") and f"{x},{y}" not in pets and f"{x},{y}" not in ign: bad.append(f"{c}@{x},{y}")
print(" ".join(bad))')
  [ -n "$adj" ] && { echo "STOP: adjacent $adj"; break; }
done
echo "$out" | grep -E '^0[4-7] |^34|^Neigh'
