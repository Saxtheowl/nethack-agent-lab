#!/bin/bash
# slots/3/uni GEMS [MAXSTEPS]: chase a PEACEFUL co-aligned unicorn ('u') in a lit room and throw the gems
# (inventory letters, e.g. "qEE") at it whenever it is in line (<= 6 squares, nothing in between).
# Steps toward it otherwise (only onto '·' floor squares). Stops on: HP loss, a non-'u' monster letter
# within 2 squares, a prompt/--More--/Really attack, no unicorn visible, all gems thrown, MAXSTEPS.
# Prints every accept message (gratefully = real gem, +luck; graciously = glass). Run via slots/3/w ./uni
cd "$(dirname "$0")"
exec python3 - "$@" <<'PY'
import subprocess, sys, re
gems = list(sys.argv[1]); N = int(sys.argv[2]) if len(sys.argv) > 2 else 20
IGN = '@uG' + (sys.argv[3] if len(sys.argv) > 3 else '')
def v(): return subprocess.run(['./v'], capture_output=True, text=True).stdout
def k(*a): return subprocess.run(['./k', '--why', 'unicorn gem throw'] + list(a), capture_output=True, text=True).stdout
def parse(s):
    rows = {}
    for l in s.splitlines():
        m = re.match(r'^(\d\d) (.*)$', l)
        if m: rows[int(m[1])] = m[2]
    c = re.search(r'Terminal cursor[^:]*: (\d+),(\d+)', s)
    hp = re.search(r'HP:(\d+)\((\d+)\)', s)
    mf = re.search(r'^Map features.*$', s, re.M)
    mons = []
    if mf:
        for g, x, y in re.findall(r" (\S)@(\d+),(\d+)", mf[0]):
            if re.match(r"[A-Za-z&;:'@]", g): mons.append((g, int(x), int(y)))
    return rows, int(c[1]), int(c[2]), int(hp[1]) if hp else None, mons
DIR = {(-1,-1):'7',(0,-1):'8',(1,-1):'9',(-1,0):'4',(1,0):'6',(-1,1):'1',(0,1):'2',(1,1):'3'}
sg = lambda a: (a > 0) - (a < 0)
hp0 = None
verified = set()
ignore = set()
for i in range(N):
    if not gems: print('all gems thrown'); break
    s = v(); rows, hx, hy, hp, mons = parse(s)
    if hy < 10: print('STOP prompt/menu'); break
    last = [l for l in s.splitlines() if re.match(r'^0\d ', l)]
    if last and re.search(r'--More--|Really attack|stole|seduces', last[-1]): print('STOP message', last[-1]); break
    if hp0 is not None and hp is not None and hp < hp0: print('STOP HP loss'); break
    hp0 = hp
    others = [m for m in mons if m[0] not in IGN and max(abs(m[1]-hx), abs(m[2]-hy)) <= 2]
    if others: print('STOP monster near', others); break
    us = [m for m in mons if m[0] == 'u' and (m[1], m[2]) not in ignore]
    if not us: print('STOP no unicorn visible'); break
    _, ux, uy = min(us, key=lambda m: max(abs(m[1]-hx), abs(m[2]-hy)))
    dx, dy = ux - hx, uy - hy
    d = max(abs(dx), abs(dy))
    aligned = (dx == 0 or dy == 0 or abs(dx) == abs(dy)) and d <= 6
    if aligned:
        sx, sy = sg(dx), sg(dy)
        clear = all(not any((m[1], m[2]) == (hx+sx*j, hy+sy*j) for m in mons) for j in range(1, d))
        if clear and (ux, uy) not in verified:
            lk = subprocess.run(['./look', str(ux), str(uy)], capture_output=True, text=True).stdout
            if 'unicorn' in lk and 'peaceful' in lk and 'statue' not in lk: verified.add((ux, uy))
            else:
                print('skip (not a peaceful unicorn):', ux, uy, lk.strip()[:60]); ignore.add((ux, uy)); continue
        if clear:
            verified.clear()
            g = gems.pop(0)
            out = k('t' + g + DIR[(sx, sy)])
            msg = ' '.join(l[4:].strip(' │') for l in out.splitlines() if re.match(r'^0[1-7] ', l))
            m = re.findall(r'[^.!]*(?:accepts|not interested|catches|hits|misses)[^.!]*[.!]', msg)
            print(f'THROW {g} at {ux},{uy} from {hx},{hy}:', m[-2:] if m else msg[-200:])
            continue
    # step: prefer a floor square from which the unicorn is in line, else the one closest to it
    best = None
    for (ddx, ddy), key in DIR.items():
        nx, ny = hx + ddx, hy + ddy
        r = rows.get(ny, '')
        if not (0 <= nx < len(r)) or r[nx] != '·': continue
        if any((m[1], m[2]) == (nx, ny) for m in mons): continue
        ex, ey = ux - nx, uy - ny
        al = (ex == 0 or ey == 0 or abs(ex) == abs(ey)) and max(abs(ex), abs(ey)) <= 6
        score = (0 if al else 1, max(abs(ex), abs(ey)))
        if best is None or score < best[0]: best = (score, key)
    if not best: print('STOP no step'); break
    k(best[1])
else:
    print('STOP steps', N)
s = v()
print(re.search(r'HP:\d+\(\d+\).*T:\d+', s)[0], 'gems left:', ''.join(gems))
for l in s.splitlines():
    if re.match(r'^0[5-7] |^Map', l): print(l)
PY
