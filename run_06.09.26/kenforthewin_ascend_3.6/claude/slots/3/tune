#!/bin/bash
# slots/3/tune NOTES : apply the harp j, answer "Improvise?" n, play the 5 NOTES (A-G) and print the
# feedback line (tumblers/gears, drawbridge message). NOTES=PASS answers y to "Play the passtune?".
# Checks each prompt before typing; Escape on anything unexpected. Run via slots/3/w ./tune
cd "$(dirname "$0")"
t=$1
o=$(./k --why "play the harp at the drawbridge ($t)" aj)
echo "$o" | grep -q 'Improvise?' || { ./k --named Escape >/dev/null; echo "no Improvise prompt"; echo "$o" | grep -E '^0[5-7]'; exit 1; }
o=$(./k --raw n)
if echo "$o" | grep -q 'Play the passtune?'; then
  if [ "$t" = PASS ]; then o=$(./k --raw y); else o=$(./k --raw n); fi
fi
if [ "$t" != PASS ]; then
  echo "$o" | grep -q 'What tune are you playing' || { ./k --named Escape >/dev/null; echo "no tune prompt"; echo "$o" | grep -E '^0[5-7]'; exit 1; }
  ./k --raw "$t" >/dev/null
  o=$(./k --named Enter)
fi
echo "$o" | grep -E '^0[1-7]|^34' | sed 's/^0[5-7] │//; s/ *│$//'
