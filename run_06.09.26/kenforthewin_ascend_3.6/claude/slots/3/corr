#!/bin/bash
# slots/3/corr [maxsteps]: follow a corridor: step to the unvisited walkable neighbour
# (corridor/floor/door) that is not where we came from; prefers unexplored-adjacent cells.
# Stops at forks with 2+ new options, on HP loss, monsters adjacent, messages, or when nothing new.
cd "$(dirname "$0")/../.."
export NH_SLOT=3
python3 - "${1:-30}" <<'PY'
import sys, re, time, subprocess
sys.path.insert(0, 'scripts')
import session, guard
maxs = int(sys.argv[1])
K = {(-1,-1):'7',(0,-1):'8',(1,-1):'9',(-1,0):'4',(1,0):'6',(-1,1):'1',(0,1):'2',(1,1):'3'}
WALK = set('▒·#.<>$%!?=()[/*"_{')
visited = set()
st = guard.state(*guard.observe(session))
hp0 = st['hp']
for step in range(maxs):
    rows = st['rows']; x, y = st['position']; visited.add((x, y))
    def t(a, b):
        return rows[b][a:a+1] if 0 <= b < len(rows) else ' '
    # monsters adjacent?
    adj = [(dx,dy) for (dx,dy) in K if (t(x+dx,y+dy).isalpha() or t(x+dx,y+dy) in '@&;:') and (x+dx,y+dy) not in st.get('pets',())]
    if adj: print('STOP: monster adjacent'); break
    opts = []
    for (dx,dy),k in K.items():
        c = t(x+dx, y+dy)
        if c in WALK and (x+dx,y+dy) not in visited:
            if dx and dy and (t(x+dx,y) in '│─┌┐└┘|-+' or t(x,y+dy) in '│─┌┐└┘|-+'):
                pass
            unk = sum(1 for (ex,ey) in K if t(x+dx+ex, y+dy+ey) == ' ')
            opts.append((unk, k, (x+dx,y+dy)))
    if not opts: print('STOP: dead end / nothing new'); break
    opts.sort(reverse=True)
    if len(opts) > 1 and opts[0][0] == opts[1][0] and step > 0 and opts[0][0] > 0:
        # fork: pick the first anyway but report
        pass
    k = opts[0][1]
    subprocess.run(['python3','scripts/session.py','keys','--why','suivre le couloir',k], capture_output=True)
    obs = guard.observe(session)
    st2 = guard.state(*obs)
    if st2 is None: print('STOP: prompt/unknown state'); break
    if st2['hp'] < hp0: print('STOP: HP loss'); break
    if st2['position'] == (x, y): print('STOP: did not move'); break
    if st2['level'] != st['level']: print('STOP: level change'); break
    st = st2
print('pos', st['position'])
PY
python3 scripts/session.py screen --compact | grep -E '^0[5-7] |^34|^Neigh'
