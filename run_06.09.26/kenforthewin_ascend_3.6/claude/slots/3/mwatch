#!/bin/bash
# slots/3/mwatch N [XMAX]: (blind, telepathy) pass up to N single turns; stop as soon as a monster letter
# 'H' with x <= XMAX (default 13: the Castle west maze/courtyard) is in line with @ (row, column or
# diagonal) within 7 squares, or within 2 squares, or on HP loss / prompt / message. Prints its position.
# Run via slots/3/w ./mwatch
cd "$(dirname "$0")"
n=${1:-10}; XM=${2:-13}; prev=""
for i in $(seq "$n"); do
  out=$(./k --why "watch the minotaur" s 2>&1)
  s=$(./v)
  hp=$(echo "$s" | grep -o 'HP:[0-9]*' | head -1 | cut -d: -f2)
  [ -n "$prev" ] && [ "$hp" -lt "$prev" ] && { echo "STOP: HP loss $prev -> $hp"; break; }
  prev=$hp
  cy=$(echo "$s" | grep -o 'Terminal cursor[^:]*: [0-9]*,[0-9]*' | grep -o '[0-9]*$')
  [ "${cy:-0}" -lt 10 ] && { echo "STOP: prompt"; break; }
  me=$(echo "$s" | grep -o 'Terminal cursor[^:]*: [0-9]*,[0-9]*' | grep -o '[0-9]*,[0-9]*$')
  mx=${me%,*}; my=${me#*,}
  r=$(echo "$s" | grep '^Map' | grep -oE 'H@[0-9]+,[0-9]+' | while read h; do p=${h#H@}; x=${p%,*}; y=${p#*,};
      [ "$x" -gt "$XM" ] && continue
      dx=$((x-mx)); dy=$((y-my)); ax=${dx#-}; ay=${dy#-}; d=$(( ax>ay ? ax : ay ))
      if [ $d -le 2 ]; then echo "NEAR $x,$y d=$d"; elif [ $x -ge ${XMIN:-8} ] && [ $d -le 7 ] && { [ $dx -eq 0 ] || [ $dy -eq 0 ] || [ $ax -eq $ay ]; }; then echo "ALIGNED $x,$y d=$d"; else echo "far $x,$y"; fi; done)
  echo "T$(echo "$s" | grep -oE 'T:[0-9]+' | cut -d: -f2) HP$hp me $me : $r"
  echo "$r" | grep -qE 'NEAR|ALIGNED' && { echo "STOP: minotaur"; break; }
done
