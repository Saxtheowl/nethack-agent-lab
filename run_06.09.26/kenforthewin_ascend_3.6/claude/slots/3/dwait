#!/bin/bash
# slots/3/dwait N GLYPHS: up to N single searches (1 action each) until a PET shown with one of GLYPHS
# (e.g. "D" or "Dw") is adjacent. Stops on HP loss, status change, prompt/--More--, steal/engulf
# messages, or any NON-pet monster adjacent. Run via slots/3/w ./dwait
cd "$(dirname "$0")/../.."
export NH_SLOT=3
S="python3 scripts/session.py"
n=${1:-10}; want="${2:-D}"
prev=""
for i in $(seq "$n"); do
  out=$($S keys --compact s 2>&1)
  hp=$(echo "$out" | grep -o 'HP:[0-9]*' | head -1 | cut -d: -f2)
  st=$(echo "$out" | grep -E '^34 ' | grep -oE 'Hungry|Weak|Fainting|Stone|Slime|Blind|Conf|Stun|Ill|FoodPois|Hallu')
  if [ -n "$prev" ] && [ "$hp" -lt "$prev" ]; then echo "STOP: HP loss $prev -> $hp"; break; fi
  prev=$hp
  [ -n "$st" ] && { echo "STOP: status $st"; break; }
  cy=$(echo "$out" | grep -o 'Terminal cursor[^:]*: [0-9]*,[0-9]*' | grep -o '[0-9]*$')
  [ "${cy:-0}" -lt 10 ] && { echo "STOP: prompt (cursor row $cy)"; break; }
  echo "$out" | grep -E '^0[1-7] ' | tail -3 | grep -qiE 'stole|steal|seduc|engulf|swallow|--More--|>>' && { echo "STOP: message"; break; }
  res=$(echo "$out" | WANT="$want" python3 -c '
import re,sys,os
t=sys.stdin.read()
want=os.environ.get("WANT","D")
n=re.search(r"^Neighbors of @\((\d+),(\d+)\): (.*)$",t,re.M)
pm=re.search(r"^PETS.*$",t,re.M); pets=pm.group(0) if pm else ""
bad=[]; good=[]
for k,c,x,y in re.findall(r"(\d):(.)\((\d+),(\d+)\)",n.group(3)):
    if c.isalpha() or c in "@&;:\x27":
        if f"{x},{y}" in pets:
            if c in want: good.append(f"{c}@{x},{y}")
        else: bad.append(f"{c}@{x},{y}")
print(("BAD " + " ".join(bad)) if bad else ("GOOD " + " ".join(good)) if good else "")')
  case "$res" in
    BAD*) echo "STOP: adjacent ${res#BAD }"; break;;
    GOOD*) echo "PET adjacent: ${res#GOOD }"; break;;
  esac
done
echo "$out" | grep -E '^0[4-7] |^34|^Neigh|^PETS'
