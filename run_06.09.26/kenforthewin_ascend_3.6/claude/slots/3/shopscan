#!/bin/bash
# shopscan KEY COUNT : step COUNT times with KEY, at each square list items for sale (via ':')
cd "$(dirname "$0")"
key=$1; n=$2
for i in $(seq 1 $n); do
  ./k "$key" >/dev/null
  pos=$(./v | grep Terminal | grep -oE '[0-9]+,[0-9]+')
  ./k : >/dev/null
  s=$(./v)
  echo "$s" | grep -oE '(a|an|[0-9]+) [^│]*\(for sale, [0-9]+ zorkmids[^)]*\)' | sed "s/^/$pos /"
  for j in 1 2 3; do s=$(./v); echo "$s" | grep -qE 'More|>>|Things that are here' && ./k --named Escape >/dev/null || break; done
done
./v | grep -E '^34'
