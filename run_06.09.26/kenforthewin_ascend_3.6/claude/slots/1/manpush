#!/bin/bash
# slots/1/manpush "k:x,y k:x,y ..." : send each movement key, verify hero lands on x,y; stop on mismatch/HP loss/prompt.
cd "$(dirname "$0")/../.."
S="slots/1/session"
prev=$($S screen --compact | grep -oP 'HP:\K\d+')
for kv in $1; do k=${kv%%:*}; want=${kv#*:}
  o=$($S keys --compact --why 'sokoban manual push' $k)
  pos=$(echo "$o" | grep -oP 'Neighbors of @\(\K[0-9,]+')
  hp=$(echo "$o" | grep -oP 'HP:\K\d+')
  if [ "$pos" != "$want" ]; then echo "MISMATCH after $k: at $pos want $want"; echo "$o" | grep -E '^0[5-7]'; exit 1; fi
  if [ -n "$hp" ] && [ "$hp" -lt "$prev" ]; then echo "HP loss $prev->$hp"; echo "$o" | grep -E '^0[5-7]'; exit 1; fi
  echo "$o" | grep -qE '\[yn|--More--' && { echo "prompt"; echo "$o" | grep -E '^0[5-7]'; exit 1; }
  prev=$hp
done
echo "manpush done at $pos"
