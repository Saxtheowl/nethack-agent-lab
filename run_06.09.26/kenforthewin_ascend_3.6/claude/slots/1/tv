#!/bin/bash
# slots/1/tv X Y [N] : repeated travel to X,Y; stops on arrival, no progress, HP loss, "stole", status change. Prints last messages + neighbors.
cd "$(dirname "$0")/../.."
slots/1/session keys --named Escape >/dev/null 2>&1
S="slots/1/session"; tx=$1; ty=$2; n=${3:-10}; last=; hp0=
for i in $(seq $n); do
  o=$($S travel $tx $ty 2>&1)
  hp=$(echo "$o"|grep -oP 'HP:\K\d+'|head -1); pos=$(echo "$o"|grep -oP 'of @\(\K[0-9,]+')
  [ -n "$hp0" ] && [ "$hp" -lt "$hp0" ] && { echo "stop: HP $hp0->$hp"; break; }
  echo "$o" | grep -qiE 'stole|steals|Stone|Slime|Blind|Hallu|Conf|Stun' && { echo "stop: event"; break; }
  [ "$pos" = "$last" ] && { echo "stop: no progress"; break; }
  [ "$pos" = "$tx,$ty" ] && { echo "arrived"; break; }
  last=$pos; hp0=$hp
done
echo "$o" | grep -E '^0[5-7] |HP:|Neigh'
