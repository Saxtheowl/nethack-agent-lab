#!/bin/bash
# slots/8/m: full map (rows 10-31 of the screen, 82 cols) with x ruler + status + neighbors.
cd "$(dirname "$0")/../.."
export NH_SLOT=8
s=$(python3 scripts/session.py screen)
echo "   0         1         2         3         4         5         6         7"
echo "   01234567890123456789012345678901234567890123456789012345678901234567890123456789"
echo "$s" | awk 'NR>=2 && NR<=8 {printf "M  %s\n", substr($0,2,80)} NR>=11 && NR<=31 {printf "%02d %s\n", NR-1, substr($0,2,80)} NR>=33 && NR<=34 {print "   " substr($0,2,80)}' | sed 's/ *$//' | grep -v '^[0-9][0-9] *$'
python3 scripts/session.py screen --compact | grep -E '^(Map features|PETS|Neighbors)'
