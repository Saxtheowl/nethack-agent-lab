#!/bin/bash
# slots/8/lootc X,Y: travel to a container, force it open if locked (Excalibur), take out all items except gray stones. Run via slots/8/w.
cd "$(dirname "$0")/../.."
export NH_SLOT=8
S="python3 scripts/session.py"
K() { $S keys --compact --raw --why "loot container" "$@" 2>/dev/null; }
x=${1%,*}; y=${1#*,}
timeout 60 slots/8/tv $x $y 8 >/dev/null 2>&1
$S keys --named Escape >/dev/null 2>&1
K "#loot" >/dev/null; $S keys --named C-m >/dev/null
o=$(K y)
if echo "$o" | grep -q "locked"; then
  K "#force" >/dev/null; $S keys --named C-m >/dev/null; K y >/dev/null
  for i in $(seq 15); do o=$(K s); echo "$o" | grep -qE "succeed|You stop|break open|In fact" && break; done
  echo "$o" | grep -E "^07" | tail -1
  $S keys --named Escape >/dev/null
  K "#loot" >/dev/null; $S keys --named C-m >/dev/null; o=$(K y)
fi
scr=$($S screen)
echo "$scr" | grep -q "Do what with" || { echo "$o" | grep -E "^0[67]"; exit 0; }
K o >/dev/null
scr=$($S screen)
if echo "$scr" | grep -q "Take out what type"; then K a >/dev/null; $S keys --named C-m >/dev/null; scr=$($S screen); fi
if echo "$scr" | grep -q "Take out what"; then
  letters=$(echo "$scr" | grep -oE "│ ?[a-zA-Z$]\) [^│]*" | grep -viE "gr[ae]y stone|boulder" | grep -oE "^│ ?[a-zA-Z$]" | tr -d '│ ' | tr -d '\n')
  [ -n "$letters" ] && K "$letters" >/dev/null
  $S keys --named C-m >/dev/null
fi
$S screen --compact | grep -E "^0[5-7] "
