#!/bin/bash
# slots/8/killadj [rounds] [minHP]: repeatedly attack any adjacent HOSTILE monster (farlook checks; skips peaceful/pets,
# floating eyes, molds, gas spores, nymph-> still attack). Stops when none adjacent or HP<minHP. Run via slots/8/w.
cd "$(dirname "$0")/../.."
export NH_SLOT=8
S="python3 scripts/session.py"
declare -A known
for r in $(seq ${1:-20}); do
  $S keys --named Escape >/dev/null 2>&1
  o=$($S screen --compact)
  hp=$(echo "$o" | grep -o 'HP:[0-9]*' | head -1 | cut -d: -f2)
  [ "$hp" -lt "${2:-35}" ] && { echo "STOP: HP $hp"; break; }
  me=$(echo "$o" | grep -o 'hero when no menu): [0-9]*,[0-9]*' | grep -o '[0-9]*,[0-9]*$')
  mx=${me%,*}; my=${me#*,}
  pets=$(echo "$o" | grep '^PETS')
  target=""
  for d in 7 8 9 4 6 1 2 3; do
    case $d in 7) dx=-1;dy=-1;; 8) dx=0;dy=-1;; 9) dx=1;dy=-1;; 4) dx=-1;dy=0;; 6) dx=1;dy=0;; 1) dx=-1;dy=1;; 2) dx=0;dy=1;; 3) dx=1;dy=1;; esac
    x=$((mx+dx)); y=$((my+dy))
    echo "$o" | grep '^Map' | grep -qE " [A-Za-z&;:'@]@$x,$y( |$)" || continue
    echo "$pets" | grep -q "$x,$y" && continue
    name=$(scripts/look $x $y 2>/dev/null | tail -1)
    echo "$name" | grep -qE "peaceful|called Wish4|floating eye|gas spore|mold\)|jelly\)|statue" && continue
    target=$d; echo "  $d: $name"; break
  done
  [ -z "$target" ] && { echo "none adjacent"; break; }
  $S keys --compact --raw --why "attack adjacent hostile" F$target | grep -E "^07 " | tail -1
done
$S screen --compact | grep -E "^34"
