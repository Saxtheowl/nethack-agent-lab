#!/bin/bash
# slots/4/ff <dir> [n] : F<dir> up to n times (default 3); stop if one exchange costs >=1/5 max HP or HP<60%, target gone, or HP < 50%.
cd "$(dirname "$0")/../.."
export NH_SLOT=4
S="python3 scripts/session.py"
d="$1"; n="${2:-3}"
s0=$($S screen --compact); hp0=$(echo "$s0" | grep -o 'HP:[0-9]*' | head -1 | cut -d: -f2)
for i in $(seq "$n"); do
  out=$($S keys --compact --raw "F$d" 2>&1)
  hp=$(echo "$out" | grep -o 'HP:[0-9]*(' | head -1 | tr -dc 0-9); mx=$(echo "$out" | grep -o 'HP:[0-9]*([0-9]*' | head -1 | sed 's/.*(//')
  echo "[$i] HP:$hp/$mx $(echo "$out" | grep -E '^0[1-7] ' | tail -1 | cut -c5-85)"
  echo "$out" | grep -qE -- '--More--|\[yn|You die' && { echo "STOP: prompt"; break; }
  [[ -n "$hp" && $(( (hp0-hp)*5 )) -ge "$mx" ]] && { echo "STOP: big HP loss ($hp0->$hp)"; break; }
  [[ -n "$hp" && $((hp*10)) -lt $((mx*6)) ]] && { echo "STOP: HP<60%"; break; }
  hp0=$hp
  echo "$out" | grep -E '^0[1-7] ' | tail -1 | grep -qE "You (kill|destroy)|killed" && { echo "killed"; break; }
done
echo "$out" | grep -E '^Map|^PETS|^Neigh'
