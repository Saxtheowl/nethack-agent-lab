#!/bin/bash
# slots/4/follow [n] : walk along a corridor using the Neighbors line; at each step go to the unvisited
# corridor/door/floor neighbour farthest from the previous square; stop at forks (tie), dead ends,
# rooms (floor '·' reached), monsters, HP loss.
cd "$(dirname "$0")/../.."
export NH_SLOT=4
python3 - "${1:-30}" <<'PY'
import sys, re, subprocess
n=int(sys.argv[1])
keys={(0,-1):'8',(1,0):'6',(0,1):'2',(-1,0):'4',(1,-1):'9',(1,1):'3',(-1,1):'1',(-1,-1):'7'}
def scr(): return subprocess.run(['python3','scripts/session.py','screen','--compact'],capture_output=True,text=True).stdout
def send(k): return subprocess.run(['python3','scripts/session.py','keys','--compact','--raw',k],capture_output=True,text=True).stdout
s=scr(); visited=[]; prev=None
hp0=int(re.search(r'HP:(\d+)',s)[1])
for i in range(n):
    m=re.search(r'Neighbors of @\((\d+),(\d+)\): (.*)',s)
    x,y=int(m[1]),int(m[2]); visited.append((x,y))
    cands=[]
    for d,g,a,b in re.findall(r'(\d):(\S+?)\((\d+),(\d+)\)',m[3]):
        a,b=int(a),int(b)
        if g[0].isalpha() and g!='blank' or g in '@&': print('STOP monster',g,a,b); sys.exit()
        if g in ('▒','#','·','.','|','-','+') and (a,b) not in visited:
            if g in '|-' and (a!=x and b!=y): continue
            cands.append((a,b,d,g))
    if prev: cands.sort(key=lambda c:-max(abs(c[0]-prev[0]),abs(c[1]-prev[1])))
    if not cands: print('STOP dead end'); break
    if prev and len(cands)>1 and max(abs(cands[0][0]-prev[0]),abs(cands[0][1]-prev[1]))==max(abs(cands[1][0]-prev[0]),abs(cands[1][1]-prev[1])):
        print('STOP fork',[(c[2],c[3]) for c in cands]); break
    if not prev and len(cands)>1: print('STOP need direction',[(c[2],c[3]) for c in cands]); break
    c=cands[0]; s=send(c[2])
    hp=int(re.search(r'HP:(\d+)',s)[1])
    if hp<hp0: print('STOP HP loss'); break
    prev=(x,y)
    if c[3] in '·.': print('STOP room/door'); break
s=scr(); print(re.search(r'Neighbors of @\(\d+,\d+\)',s)[0])
PY
python3 scripts/session.py screen --compact | grep -E '^34|^Map'
