#!/bin/bash
# slots/4/follow [n] [initial dir key] : follow a corridor: step to the unique walkable neighbour not visited; stop at forks, rooms, monsters, HP loss.
cd "$(dirname "$0")/../.."
export NH_SLOT=4
python3 - "${1:-30}" ${2:-} <<'PY'
import sys, re, time
sys.path.insert(0,'scripts')
import session, guard
n=int(sys.argv[1])
keys={(0,-1):'8',(1,0):'6',(0,1):'2',(-1,0):'4',(1,-1):'9',(1,1):'3',(-1,1):'1',(-1,-1):'7'}
visited=set(); prev=None
st=guard.state(*guard.observe(session)); hp0=st['hp']
if len(sys.argv)>2:
    d={v:k for k,v in keys.items()}[sys.argv[2]]; x,y=st['position']; prev=(x-d[0],y-d[1])
for i in range(n):
    rows=st['rows']; x,y=st['position']; visited.add((x,y))
    cands=[]
    for (dx,dy),k in keys.items():
        c=rows[y+dy][x+dx] if 0<=y+dy<len(rows) and 0<=x+dx<len(rows[y+dy]) else ' '
        if (x+dx,y+dy) in visited: continue
        if prev and max(abs(x+dx-prev[0]),abs(y+dy-prev[1]))<=1 and (x+dx==prev[0] or y+dy==prev[1]) and not (dx and dy): continue
        if prev and (x+dx,y+dy)==prev: continue
        if any(max(abs(x+dx-a),abs(y+dy-b))<=1 for (a,b) in visited if (a,b)!=(x,y)): continue
        if c in '▒#': cands.append(((dx,dy),k,c))
        elif c in '·.+|-' and c!=' ': cands.append(((dx,dy),k,c))
        elif c.isalpha() or c in '@&': print('STOP monster',c,x+dx,y+dy); sys.exit()
    corr=[c for c in cands if c[2] in '▒#']
    if len(corr)!=1:
        print('STOP fork/end', [(c[1],c[2]) for c in cands]); break
    session.send(corr[0][1]); 
    obs=guard.settled(session); st2=guard.state(*obs) if obs else None
    if st2 is None: print('STOP prompt'); break
    if st2['hp']<hp0: print('STOP HP loss'); st=st2; break
    if st2['position']==(x,y): print('STOP blocked'); break
    prev=(x,y); st=st2
print('pos',st['position'],'HP',st['hp'])
PY
python3 scripts/session.py screen --compact | grep -E '^0[5-7] |^34|^Map'
