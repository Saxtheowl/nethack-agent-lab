#!/bin/bash
# restfight TARGET% N: rest one turn at a time; if a hostile L/&/letter monster becomes adjacent,
# hit it once (F dir), then keep going. Stops on HP < 55%, status problems, '@' (farlook needed), 'e', or target.
cd "$(dirname "$0")"
target=${1:-85}; n=${2:-80}
declare -A D=([-1,-1]=7 [0,-1]=8 [1,-1]=9 [-1,0]=4 [1,0]=6 [-1,1]=1 [0,1]=2 [1,1]=3)
for i in $(seq $n); do
  s=$(./v)
  hp=$(echo "$s" | grep -o 'HP:[0-9]*([0-9]*)' | head -1); cur=${hp#HP:}; cur=${cur%%(*}; max=${hp#*(}; max=${max%)}
  [ $((cur * 100)) -lt $((max * 55)) ] && { echo "LOW HP $cur"; break; }
  echo "$s" | grep -E 'HP:[0-9]' | grep -qE 'Hungry|Weak|Faint|Stone|Slime|Conf|Stun|Blind' && { echo "STATUS"; break; }
  echo "$s" | grep -E '^0[1-9]' | tail -2 | grep -qiE 'stole' && { echo "STOLE"; break; }
  pos=$(echo "$s" | grep -oE 'Terminal cursor[^:]*: [0-9]+,[0-9]+' | grep -oE '[0-9]+,[0-9]+'); hx=${pos%,*}; hy=${pos#*,}
  mf=$(echo "$s" | grep '^Map features')
  adj=""
  for m in $(echo "$mf" | grep -oE " [A-Za-z&;:'@]@[0-9]+,[0-9]+"); do c=${m:2}; x=${c%,*}; y=${c#*,}; g=${m:0:1}; dx=$((x-hx)); dy=$((y-hy));
    [ ${dx#-} -le 1 ] && [ ${dy#-} -le 1 ] && [ "$dx,$dy" != "0,0" ] && adj="$g ${D[$dx,$dy]}"; done
  if [ -n "$adj" ]; then g=${adj% *}; d=${adj#* }
    case "$g" in @|e) echo "ADJ $g: decide by hand"; break;; esac
    o=$(./k F$d --raw 2>&1); echo -n "[F$d $(echo "$o" | grep -E '^0[1-9]' | tail -1 | cut -c5-50)] "
    echo "$o" | grep -q ALARM && { echo ALARM; break; }
    continue
  fi
  [ $((cur * 100)) -ge $((max * target)) ] && { echo FULL; break; }
  ./k s --raw >/dev/null 2>&1; echo -n "$cur "
done
./v | grep -oE 'HP:[0-9]+\([0-9]+\).*T:[0-9]+'
