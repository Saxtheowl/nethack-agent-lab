#!/bin/bash
# fa [N] [minHP%]: fight adjacent hostile monsters (farlook each new target: skips peaceful/@/e/floating eye/cockatrice-free).
# Stops when none adjacent, HP < minHP% (default 50), ALARM, or status problem.
cd "$(dirname "$0")"
n=${1:-20}; mn=${2:-50}
declare -A D=([-1,-1]=7 [0,-1]=8 [1,-1]=9 [-1,0]=4 [1,0]=6 [-1,1]=1 [0,1]=2 [1,1]=3)
last=""
for i in $(seq $n); do
  ./k --named Escape >/dev/null 2>&1
  s=$(./v)
  hp=$(echo "$s" | grep -o 'HP:[0-9]*([0-9]*)' | head -1); cur=${hp#HP:}; cur=${cur%%(*}; max=${hp#*(}; max=${max%)}
  [ $((cur * 100)) -lt $((max * mn)) ] && { echo "LOW HP $cur"; break; }
  echo "$s" | grep -E 'HP:[0-9]' | grep -qE 'Stone|Slime|Stun' && { echo "STATUS"; break; }
  pos=$(echo "$s" | grep -oE 'Terminal cursor[^:]*: [0-9]+,[0-9]+' | grep -oE '[0-9]+,[0-9]+'); hx=${pos%,*}; hy=${pos#*,}
  mf=$(echo "$s" | grep '^Map features')
  adj=""
  for m in $(echo "$mf" | grep -oE " [A-Za-z&;:']@[0-9]+,[0-9]+"); do c=${m:2}; x=${c%,*}; y=${c#*,}; g=${m:0:1}; dx=$((x-hx)); dy=$((y-hy));
    [ ${dx#-} -le 1 ] && [ ${dy#-} -le 1 ] && [ "$dx,$dy" != "0,0" ] && [ "$g" != "e" ] && adj="$g $x $y ${D[$dx,$dy]}"; done
  [ -z "$adj" ] && { echo "none adjacent"; break; }
  set -- $adj
  if [ "$last" != "$2,$3" ]; then
    desc=$(./look $2 $3 2>&1 | tail -1); ./k --named Escape >/dev/null 2>&1
    echo "$desc" | grep -qiE 'peaceful|tame|shopkeeper|priest|guard|watch' && { echo "PEACEFUL: $desc"; break; }
    echo "$desc" | grep -qiE 'floating eye|gelatinous|jelly|acid blob' && { echo "AVOID: $desc"; break; }
    last="$2,$3"
  fi
  o=$(./k F$4 --raw 2>&1); echo "$o" | grep -q ALARM && { echo ALARM; break; }
  echo "[$1 F$4: $(echo "$o" | grep -E '^0[1-9]' | tail -1 | cut -c5-60)]"
done
./v | grep -oE 'HP:[0-9]+\([0-9]+\).*T:[0-9]+'
