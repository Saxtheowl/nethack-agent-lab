#!/bin/bash
# map: print the map window rows 10-30 with x rulers (full screen, no compaction)
cd "$(dirname "$0")/../.."
NH_SLOT=3 scripts/slotrun python3 scripts/session.py screen | python3 -c "
import sys; L=sys.stdin.read().splitlines()
print('   '+''.join(str(i//10) for i in range(81)));print('   '+''.join(str(i%10) for i in range(81)))
for y in range(10,31): print('%02d '%y+L[y][:81])"
