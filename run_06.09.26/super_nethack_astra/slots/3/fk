#!/bin/bash
# fk G [N] [MINHP]: F-attack the adjacent monster shown as glyph G (never '@'), up to N blows; stops when gone/not adjacent/HP<MINHP.
cd "$(dirname "$0")"
G=$1; N=${2:-6}; MIN=${3:-80}
[ "$G" = "@" ] && { echo "refuse @"; exit 1; }
for i in $(seq 1 $N); do
  s=$(./v); me=$(echo "$s" | head -1 | grep -oE '[0-9]+,[0-9]+$'); h=$(echo "$s" | grep -oE 'HP:[0-9]+' | head -1 | cut -d: -f2)
  [ "$h" -lt "$MIN" ] && { echo "STOP HP $h"; exit 1; }
  d=$(echo "$s" | grep '^Map' | G="$G" python3 -c "
import sys,re,os
mx,my=map(int,'$me'.split(','))
for x,y in re.findall(r' '+re.escape(os.environ['G'])+r'@(\d+),(\d+)', sys.stdin.read()):
    dx,dy=int(x)-mx,int(y)-my
    if max(abs(dx),abs(dy))==1: print({(-1,-1):7,(0,-1):8,(1,-1):9,(-1,0):4,(1,0):6,(-1,1):1,(0,1):2,(1,1):3}[(dx,dy)]); break")
  [ -z "$d" ] && { echo "no adjacent $G"; exit 0; }
  o=$(./k F$d --raw --why "fk $G")
  for j in 1 2; do echo "$o" | grep -q '>>' && o=$(./k ' ' --raw); done
  echo "$o" | grep -E '^0[1-9]' | tail -1 | cut -c5-80
  echo "$o" | grep -q 'Call a' && ./k --named Escape >/dev/null
  echo "$o" | grep -qE 'Really|\[yn' && { ./k --named Escape >/dev/null; echo "STOP prompt"; exit 1; }
done
