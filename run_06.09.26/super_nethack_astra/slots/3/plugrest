#!/bin/bash
# plugrest X Y G N: search 1 turn at a time while glyph G stays at screen X,Y; stop on HP drop>4, other glyph, prompt.
cd "$(dirname "$0")"
X=$1; Y=$2; G=$3; N=${4:-20}
h0=$(./v | grep -oE 'HP:[0-9]+' | head -1 | cut -d: -f2)
for i in $(seq 1 $N); do
  s=$(./v)
  g=$(echo "$s" | grep -oE " [A-Za-z@&;:'][@]$X,$Y" | head -1 | cut -c2)
  [ "$g" != "$G" ] && { echo "STOP glyph [$g]"; exit; }
  o=$(./k s --raw 2>&1)
  for j in 1 2 3; do echo "$o" | grep -E '^0[0-9]' | tail -1 | grep -q '>>' || break; o=$(./k " " --raw 2>&1); done
  echo "$o" | grep -q ALARM && { echo "STOP ALARM"; exit; }
  h=$(./v | grep -oE 'HP:[0-9]+' | head -1 | cut -d: -f2)
  [ $((h0-h)) -gt 4 ] && { echo "STOP HP drop $h0->$h"; exit; }
  echo "$o" | grep -E '^0[0-9]' | tail -1 | grep -qiE 'stole|hungry|weak' && { echo "STOP msg"; exit; }
  h0=$h
done
echo "done HP $h $(./v | grep -oE 'T:[0-9]+')"
