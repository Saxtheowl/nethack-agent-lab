#!/bin/bash
# slots/3/sacloop : on the altar: zap create monster (s), kill what appears (non-@ via atk), offer a corpse on the altar square if any
cd "$(dirname "$0")"
./k z >/dev/null; ./k s >/dev/null; sleep 1
l=$(./v | grep -E '^07'); echo "zap: $(echo "$l" | cut -c5-70)"
echo "$l" | grep -qiE 'nothing happens|wrest' && { echo EMPTY; exit 1; }
for i in 1 2 3 4 5 6; do
  n=$(./v | grep Neighbors | head -1)
  d=$(echo "$n" | grep -oE '[0-9]:[a-zA-Z:;&'"'"']\(' | grep -v blank | head -1 | cut -c1)
  [ -z "$d" ] && break
  ./atk $d 4 60 | grep -E '^07|atk' | head -2
done
./v | grep '^34' | grep -oE 'HP:[0-9]+\([0-9]+\)'
