#!/bin/bash
# climb GLYPH NLEVELS [STOPDLVL]: repeatedly use ./stairs GLYPH, fighting adjacent monsters between tries.
# Stops when stuck (same position twice), low HP, unknown stairs, or at STOPDLVL.
cd "$(dirname "$0")"
g=${1:-<}; n=${2:-3}; stop=${3:-0}
for lv in $(seq $n); do
  prev=""
  for k in 1 2 3 4 5; do
    r=$(./stairs "$g" 2>&1)
    if echo "$r" | grep -q "Dlvl"; then echo "$r" | tail -1; break; fi
    echo "$r" | grep -qE "known|LOW" && { echo "$r"; exit 1; }
    ./fa 10 60 >/dev/null
    pos=$(./v | grep -oE 'Terminal cursor[^:]*: [0-9]+,[0-9]+')
    [ "$pos" = "$prev" ] && { echo "STUCK at $pos"; exit 1; }
    prev=$pos
  done
  d=$(./v | grep -oE 'Dlvl:[0-9]+' | cut -d: -f2); [ "$d" = "$stop" ] && { echo "reached $d"; exit 0; }
done
