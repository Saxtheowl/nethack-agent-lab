#!/bin/bash
# slots/5/chase GLYPH N MINHP: step toward nearest GLYPH monster (non-pet) and attack when adjacent; N iterations
cd "$(dirname "$0")/../.."
export NH_SLOT=5
S="python3 scripts/session.py"
for i in $(seq "${2:-8}"); do
  o=$($S screen --compact)
  h=$(echo "$o" | grep -o 'HP:[0-9]*' | head -1 | cut -d: -f2)
  [[ "$h" -lt "${3:-30}" ]] && { echo "STOP HP $h"; break; }
  d=$(python3 - "$1" "$o" <<'PY'
import re,sys
g,o=sys.argv[1],sys.argv[2]
m=re.search(r'^Map features.*$',o,re.M).group(0)
pets=set(re.findall(r'(\d+,\d+)',re.search(r'^PETS.*$',o,re.M).group(0)))
h=re.search(r'Neighbors of @\((\d+),(\d+)\)',o); hx,hy=int(h[1]),int(h[2])
best=None
for x,y in re.findall(' '+re.escape(g)+r'@(\d+),(\d+)',m):
    if f'{x},{y}' in pets: continue
    x,y=int(x),int(y); dist=max(abs(x-hx),abs(y-hy))
    if best is None or dist<best[0]: best=(dist,x,y)
if not best: print('none'); sys.exit()
dist,x,y=best
sx=(x>hx)-(x<hx); sy=(y>hy)-(y<hy)
k={(-1,-1):'7',(0,-1):'8',(1,-1):'9',(-1,0):'4',(1,0):'6',(-1,1):'1',(0,1):'2',(1,1):'3'}[(sx,sy)]
print(('F' if dist==1 else '')+k)
PY
)
  [[ "$d" == none ]] && { echo "none visible"; break; }
  r=$($S keys --compact "$d")
  echo "$d: $(echo "$r" | grep -E '^0[1-7] ' | tail -1 | cut -c5-80)"
done
$S screen --compact | grep -E '^34|^Map' 
