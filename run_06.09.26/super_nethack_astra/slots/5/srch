#!/bin/bash
# slots/5/srch N : search N times one 's' at a time; stop on HP loss, adjacent hostile, or new message of interest.
cd "$(dirname "$0")/../.."
export NH_SLOT=5
n=${1:-20}
S="python3 scripts/session.py"
hp0=$($S screen | grep -o 'HP:[0-9]*' | head -1 | cut -d: -f2)
for i in $(seq $n); do
  out=$($S keys s --settle .2 2>&1)
  hp=$(echo "$out" | grep -o 'HP:[0-9]*' | head -1 | cut -d: -f2)
  [ -n "$hp" ] && [ "$hp" -lt "$hp0" ] && { echo "srch: HP loss at $i"; break; }
  scr=$($S screen --compact)
  nb=$(echo "$scr" | grep '^Neighbors' | sed 's/^Neighbors of @([0-9,]*)://')
  pets=$(echo "$scr" | grep '^PETS')
  if echo "$nb" | grep -qE ':[a-zA-Z&;:@]\(' ; then
     # adjacent letter that is not a pet
     for c in $(echo "$nb" | grep -oE ':[a-zA-Z&;:@]\([0-9]+,[0-9]+\)' | grep -oE '[0-9]+,[0-9]+'); do
        echo "$pets" | grep -q "$c" || { echo "srch: monster adjacent at $c (i=$i)"; i=999; break; }
     done
     [ "$i" = 999 ] && break
  fi
done
$S screen --compact | grep -E '^0[1-7] |^34|^Map|^Neigh'
