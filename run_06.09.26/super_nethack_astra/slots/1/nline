#!/bin/bash
# slots/1/nline GLYPH MAXD: print direction key if a GLYPH monster is in a straight line within MAXD of the hero (cursor), else NONE
o=$(cd "$(dirname "$0")/../.." && slots/1/v)
python3 - "$o" "$1" "${2:-7}" <<'PY'
import re,sys
o,g,md=sys.argv[1],sys.argv[2],int(sys.argv[3])
c=re.search(r'Terminal cursor \(x,y[^)]*\): (\d+),(\d+)',o); hx,hy=int(c[1]),int(c[2])
m=re.search(r'^Map features.*$',o,re.M)[0]
K={(-1,-1):'7',(0,-1):'8',(1,-1):'9',(-1,0):'4',(1,0):'6',(-1,1):'1',(0,1):'2',(1,1):'3'}
for x,y in re.findall(' '+re.escape(g)+r'@(\d+),(\d+)',m):
    dx,dy=int(x)-hx,int(y)-hy; d=max(abs(dx),abs(dy))
    if d==0 or d>md: continue
    if dx and dy and abs(dx)!=abs(dy): continue
    print(K[((dx>0)-(dx<0),(dy>0)-(dy<0))], d, f'{x},{y}', f'hero {hx},{hy}'); sys.exit()
print('NONE', f'hero {hx},{hy}', ' '.join(re.findall(' '+re.escape(g)+r'@(\d+,\d+)',m)))
PY
