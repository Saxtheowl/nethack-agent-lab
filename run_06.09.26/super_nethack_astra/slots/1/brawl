#!/bin/bash
# slots/1/brawl [n] [minHP]: attack any adjacent non-pet monster (hero = cursor),
# one F per step; stop when none adjacent or HP < minHP.
cd "$(dirname "$0")/../.."
export NH_SLOT=1
n=${1:-8}; minhp=${2:-0}
for i in $(seq $n); do
  o=$(slots/1/v)
  h=$(echo "$o" | grep -oE "HP:[0-9]+" | head -1 | cut -d: -f2)
  [ "$h" -lt "$minhp" ] && { echo "brawl: low HP $h"; exit 1; }
  k=$(python3 - "$o" <<'PY'
import re, sys
o = sys.argv[1]
cur = re.search(r'Terminal cursor \(x,y[^)]*\): (\d+),(\d+)', o); hx, hy = int(cur[1]), int(cur[2])
m = re.search(r'^Map features.*$', o, re.M).group(0)
pets = set(re.findall(r'(\d+,\d+)', re.search(r'^PETS.*$', o, re.M).group(0)))
K = {(-1,-1):'7',(0,-1):'8',(1,-1):'9',(-1,0):'4',(1,0):'6',(-1,1):'1',(0,1):'2',(1,1):'3'}
for g, x, y in re.findall(r' ([A-Za-z&;:\'@])@(\d+),(\d+)', m):
    x, y = int(x), int(y)
    if (x, y) == (hx, hy) or f'{x},{y}' in pets: continue
    if g in 'G@h' : continue   # peacefuls likely: never auto-attack
    d = (x-hx, y-hy)
    if d in K: print(K[d]); break
PY
)
  [ -z "$k" ] && { echo "brawl: none adjacent"; exit 0; }
  slots/1/k --raw F$k >/dev/null; sleep .35
  slots/1/v | sed -n 10p
done
