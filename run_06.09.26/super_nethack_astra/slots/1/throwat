#!/bin/bash
# slots/1/throwat LETTER DIR: t, letter, dir — each key checked against its prompt.
cd "$(dirname "$0")/../.."
S="python3 scripts/session.py"
o=$($S keys --raw t --settle .4 --compact); echo "$o" | grep -q "What do you want to throw" || { echo "no throw prompt"; $S keys --named Escape >/dev/null; exit 1; }
o=$($S keys --raw "$1" --settle .4 --compact); echo "$o" | grep -q "In what direction" || { echo "no dir prompt"; $S keys --named Escape >/dev/null; exit 1; }
$S keys --raw "$2" --settle .6 --compact | grep -E '^0[5-7] |^34|^Map'
