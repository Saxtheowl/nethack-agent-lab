#!/bin/bash
# slots/1/sw N [TARGET_HP] [RADIUS]: search ONE turn at a time, up to N turns.
# After EVERY turn re-read HP: stop on any HP loss, on a non-pet monster within
# RADIUS (default 6), on --More--/hunger/stole messages, or when HP >= TARGET.
cd "$(dirname "$0")/../.."
n=${1:-20}; tgt=${2:-9999}; rad=${3:-6}
prev=$(slots/1/v | grep -oE 'HP:[0-9]+' | head -1 | cut -d: -f2)
for i in $(seq $n); do
  o=$(slots/1/k s)
  r=$(python3 - "$o" "$prev" "$tgt" "$rad" <<'PY'
import re, sys, os
o, prev, tgt, rad = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
hp = int(re.search(r'HP:(\d+)', o)[1])
if hp < prev: print(f'STOP HPloss {prev}->{hp}'); sys.exit()
last = [l for l in o.splitlines() if re.match(r'^0[1-7] ', l)]
last = last[-1] if last else ''
if re.search(os.environ.get('SWSTOP', r'--More--|stole|hungry|weak|faint|You feel|steal|Elbereth'), last, re.I) or '--More--' in o: print(f'STOP message {hp}: {last[4:70]}'); sys.exit()
st = re.search(r'^34 .*$', o, re.M)[0]
if re.search(r'Weak|Faint', st): print(f'STOP weak {hp}'); sys.exit()
m = re.search(r'^Map features.*$', o, re.M).group(0)
pets = set(re.findall(r'(\d+,\d+)', re.search(r'^PETS.*$', o, re.M).group(0)))
c = re.search(r'Terminal cursor \(x,y[^)]*\): (\d+),(\d+)', o); hx, hy = int(c[1]), int(c[2])
for g, x, y in re.findall(r' ([A-Za-z&;:\'@])@(\d+),(\d+)', m):
    x, y = int(x), int(y)
    if (x, y) == (hx, hy) or f'{x},{y}' in pets or g in os.environ.get('SWIGN', ''): continue
    if max(abs(x-hx), abs(y-hy)) <= rad: print(f'STOP monster {g}@{x},{y} hp{hp}'); sys.exit()
if hp >= tgt: print(f'STOP target {hp}'); sys.exit()
print(hp)
PY
)
  case "$r" in STOP*) echo "sw: $r (turn $i)"; echo "$o" | sed -n '3,4p;/^34/p'; exit 1;; esac
  prev=$r
done
echo "sw: done $n turns HP $prev"
