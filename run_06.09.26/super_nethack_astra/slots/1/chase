#!/bin/bash
# slots/1/chase GLYPH MINHP [n]: step toward the nearest GLYPH monster (straight/diag),
# attack with F when adjacent. Stops HP<MINHP, glyph gone, or steal message.
cd "$(dirname "$0")/../.."
g=${1:?}; min=${2:?}; n=${3:-10}
for i in $(seq $n); do
  o=$(slots/1/v)
  r=$(python3 - "$o" "$g" "$min" <<'PY'
import re, sys
o, g, mn = sys.argv[1], sys.argv[2], int(sys.argv[3])
if int(re.search(r'HP:(\d+)', o)[1]) < mn: print('LOW'); sys.exit()
nb = re.search(r'^Neighbors of @\((\d+),(\d+)\)', o, re.M); hx, hy = int(nb[1]), int(nb[2])
m = re.search(r'^Map features.*$', o, re.M).group(0)
ts = [(int(x), int(y)) for x, y in re.findall(' ' + re.escape(g) + r'@(\d+),(\d+)', m)]
if not ts: print('GONE'); sys.exit()
x, y = min(ts, key=lambda t: max(abs(t[0]-hx), abs(t[1]-hy)))
dx, dy = (x > hx) - (x < hx), (y > hy) - (y < hy)
K = {(-1,-1):'7',(0,-1):'8',(1,-1):'9',(-1,0):'4',(1,0):'6',(-1,1):'1',(0,1):'2',(1,1):'3'}
adj = max(abs(x-hx), abs(y-hy)) == 1
print(('F' if adj else '') + K[(dx, dy)])
PY
)
  case "$r" in LOW|GONE) echo "chase: $r"; break;; esac
  out=$(slots/1/k --compact $r); echo "$out" | grep -E '^07' | cut -c1-80
  echo "$out" | grep -qiE 'stole|steals|charms' && { echo "chase: theft"; break; }
done
