#!/usr/bin/env python3
# frontier: list known floor/corridor cells (x,y) adjacent to unknown blank cells, from the current screen.
import subprocess, os
out = subprocess.run([os.path.join(os.path.dirname(__file__), 'v')], capture_output=True, text=True).stdout
rows = {}
for l in out.split('\n'):
    if l[:2].isdigit() and 10 <= int(l[:2]) <= 31:
        rows[int(l[:2])] = ' ' + l[4:]
floor = set('·▒<>%*?^@!$[)(/=+"{')
res = []
for y, r in rows.items():
    for x, c in enumerate(r):
        if c in floor and 1 <= x < 79:
            for dx in (-1, 0, 1):
                for dy in (-1, 0, 1):
                    rr = rows.get(y + dy)
                    if rr is None or not (0 <= x + dx < len(rr)): continue
                    if rr[x + dx] == ' ' and 1 <= x + dx < 79 and 11 <= y + dy <= 31:
                        res.append((x, y))
print(sorted(set(res)))
