#!/bin/bash
# clr N MINHP: attack adjacent non-peaceful monsters (farlook each; @ skipped unless name in list),
# one blow at a time, up to N blows; never waits. Stops: none adjacent, HP<MINHP, prompt/stole/status.
D="$(dirname "$0")"
me() { c=$(echo "$1" | grep -o 'cursor[^:]*: [0-9]*,[0-9]*' | grep -o '[0-9]*,[0-9]*$'); echo "$1" | grep "^Neighbors of @($c)" | head -1; }
o=$($D/v)
for i in $(seq "$1"); do
  hp=$(echo "$o" | grep -oE 'HP:[0-9]+' | head -1 | cut -d: -f2)
  [ "$hp" -lt "$2" ] && { echo "LOW HP $hp"; exit 1; }
  echo "$o" | grep -qiE 'stole|steals|Really attack|Stiff|confuses you|--More--' && { echo ALERT; echo "$o" | grep -E '^0[5-7]'; exit 1; }
  echo "$o" | grep '^34' | grep -qE ' (Conf|Stun|Weak)' && { echo STATUS; exit 1; }
  n=$(me "$o"); d=""
  for cand in $(echo "$n" | LC_ALL=C grep -oE "[1-9]:[A-HJ-Za-z&;:'@][(][0-9]+,[0-9]+"); do
    cd_=${cand%%:*}; cxy=$(echo "$cand" | grep -oE '[0-9]+,[0-9]+'); ch=$(echo "$cand" | cut -c3)
    l=$($D/look ${cxy%,*} ${cxy#*,} 2>/dev/null | head -1 | head -c 120)
    echo "$l" | grep -qiE 'peaceful|priest|shopkeeper|watch|tame' && continue
    if [ "$ch" = "@" ]; then echo "$l" | grep -qE '\((elf-lord|Elvenking|Woodland-elf|Green-elf|Grey-elf|soldier|sergeant|lieutenant|captain)\)' || continue; fi
    d=$cd_; break
  done
  [ -z "$d" ] && { echo "none adjacent"; break; }
  o=$($D/k F$d --raw)
  echo "$o" | grep -q 'Really attack' && { $D/k --named Escape --raw >/dev/null; echo PEACEFUL-ABORT; exit 1; }
  echo "[$d] HP$(echo "$o" | grep -oE 'HP:[0-9]+' | head -1 | cut -d: -f2) $(echo "$o" | grep -E '^0[6-7]' | tr -s ' ' | tail -1)" | cut -c1-120
done
echo "$o" | grep -E '^34'; me "$o"
