#!/bin/bash
# shopscan X1 X2 Y1 Y2: farlook every object glyph in the box (free actions)
D="$(dirname "$0")"
for c in $($D/v | grep '^Map features' | grep -oE "[^ ]@[0-9]+,[0-9]+"); do
  g=${c%%@*}; xy=${c#*@}; x=${xy%,*}; y=${xy#*,}
  [ $x -ge $1 ] && [ $x -le $2 ] && [ $y -ge $3 ] && [ $y -le $4 ] || continue
  case "$g" in @|·|─|│) continue;; esac
  echo "$x,$y $($D/look $x $y 2>/dev/null | tail -1 | sed 's/  */ /g')"
done
