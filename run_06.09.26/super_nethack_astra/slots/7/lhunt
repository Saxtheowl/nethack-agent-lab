#!/bin/bash
# lhunt [n]: hunt visible leprechauns (l): attack adjacent, else travel one step toward the first one. Stops on HP<60, no l, stole.
D="$(dirname "$0")"
for j in $(seq "${1:-12}"); do
  v=$($D/v); t=$(echo "$v" | grep '^Map' | grep -oE ' l@[0-9]+,[0-9]+' | head -1 | cut -d@ -f2)
  [ -z "$t" ] && { echo "no l"; break; }
  hp=$(echo "$v" | grep -oE 'HP:[0-9]+' | head -1 | cut -d: -f2); [ "$hp" -lt 60 ] && { echo LOWHP; break; }
  d=$(echo "$v" | grep '^Neigh' | head -1 | LC_ALL=C grep -oE "[1-9]:l[(]" | head -1 | cut -c1)
  if [ -n "$d" ]; then o=$($D/k F$d --raw); echo "F$d $(echo "$o" | grep -E '^07' | tr -s ' ' | cut -c1-60)"; echo "$o" | grep -q -- '--More--' && $D/k --named Enter >/dev/null
  else $D/go ${t/,/ } 1 >/dev/null; echo "go $t"; fi
done
