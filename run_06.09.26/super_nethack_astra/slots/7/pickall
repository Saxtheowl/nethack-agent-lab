#!/bin/bash
# pickall [letters]: pick up everything here (menu: select given letters, default all on page with ',')
D="$(dirname "$0")"
$D/k --named Escape >/dev/null 2>&1
o=$($D/k , 2>&1)
if echo "$o" | grep -q "Pick up what"; then
  $D/k --raw "${1:-,}" >/dev/null 2>&1; $D/k --named Enter >/dev/null 2>&1
fi
$D/v | grep -E "^0[0-9]" | tail -3
