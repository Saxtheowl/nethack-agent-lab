#!/bin/bash
# slots/6/rest1 TARGET% MAXTURNS : single-turn searches, stop on HP drop, hunger, adjacent monster letter.
cd "$(dirname "$(readlink -f "$0")")/../.."
S="python3 scripts/session.py"; tgt=${1:-90}; prev=""
for i in $(seq ${2:-60}); do
  o=$($S keys --compact s)
  hp=$(echo "$o" | grep -o 'HP:[0-9]*([0-9]*)' | head -1); cur=${hp#HP:}; cur=${cur%%(*}; max=${hp#*(}; max=${max%)}
  [ -z "$cur" ] && { echo "NOHP"; break; }
  [ -n "$prev" ] && [ "$cur" -lt "$prev" ] && { echo "HP DROP $cur"; break; }
  echo "$o" | grep '^34' | grep -qE 'Hungry|Weak|Faint' && { echo HUNGER; break; }
  n=$(echo "$o" | grep '^Neighbors' | head -1)
  echo "$n" | sed "s/[1-9]:[${RIGN:-#}](//g" | grep -qE '[1-9]:[a-zA-Z&;:@'"'"']\(' && { echo "MONSTER ADJ: $n"; break; }
  prev=$cur
  [ $((cur * 100)) -ge $((max * tgt)) ] && { echo "OK $cur/$max"; break; }
done
echo "end HP $cur"
