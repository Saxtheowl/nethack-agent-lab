#!/bin/bash
# scripts/fight <glyph> [max]: attack the adjacent monster with that glyph
# (never a hilited pet), wait one turn if it is not adjacent; stop when gone.
cd "$(dirname "$0")/.."
g="$1"; max="${2:-6}"
for i in $(seq "$max"); do
  out=$(python3 scripts/session.py screen --compact)
  d=$(python3 - "$g" "$out" <<'PY'
import re, sys
g, out = sys.argv[1], sys.argv[2]
m = re.search(r'^Map features.*$', out, re.M).group(0)
pets = set(re.findall(r'(\d+,\d+)', re.search(r'^PETS.*$', out, re.M).group(0)))
h = re.search(r' @@(\d+),(\d+)', m)
if not h: print('nohero'); sys.exit()
hx, hy = int(h[1]), int(h[2])
best = None
for x, y in re.findall(' ' + re.escape(g) + r'@(\d+),(\d+)', m):
    if f'{x},{y}' in pets: continue
    dx, dy = int(x) - hx, int(y) - hy
    if max(abs(dx), abs(dy)) == 1:
        best = {(-1,-1):'7',(0,-1):'8',(1,-1):'9',(-1,0):'4',(1,0):'6',(-1,1):'1',(0,1):'2',(1,1):'3'}[(dx,dy)]
    elif best is None:
        best = 'far'
print(best or 'none')
PY
)
  case "$d" in
    none|nohero) break;;
    far) python3 scripts/session.py keys s >/dev/null;;
    *) python3 scripts/session.py keys "F$d" --settle .6 >/dev/null;;
  esac
done
python3 scripts/session.py screen --compact | grep -E '^0[3-7] |^34|^Map|^PETS'
