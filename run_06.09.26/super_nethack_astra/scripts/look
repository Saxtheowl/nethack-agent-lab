#!/bin/bash
# scripts/look x y : farlook a map cell (uses travel-style cursor keys from hero)
cd "$(dirname "$0")/.."
python3 - "$1" "$2" <<'PY'
import re, sys, time
sys.path.insert(0, 'scripts')
import session, guard
x, y = int(sys.argv[1]), int(sys.argv[2])
st = guard.state(*guard.observe(session))
hx, hy = st['position']
dx, dy = x - hx, y - hy
keys = ''
while dx or dy:
    sx = (dx > 0) - (dx < 0); sy = (dy > 0) - (dy < 0)
    big = {(-1,0):'H',(1,0):'L',(0,-1):'K',(0,1):'J',(-1,-1):'Y',(1,-1):'U',(-1,1):'B',(1,1):'N'}[(sx,sy)]
    small = {(-1,0):'4',(1,0):'6',(0,-1):'8',(0,1):'2',(-1,-1):'7',(1,-1):'9',(-1,1):'1',(1,1):'3'}[(sx,sy)]
    if (sx == 0 or abs(dx) >= 8) and (sy == 0 or abs(dy) >= 8):
        keys += big; dx -= 8*sx; dy -= 8*sy
    else:
        keys += small; dx -= sx; dy -= sy
session.send(';'); time.sleep(.3); session.send(keys + '.'); time.sleep(.6)
lines = [l[:81].strip(' │') for l in session.screen().splitlines()[1:8] if l.strip(' │')]
# the farlook answer starts with the glyph followed by spaces and may wrap
start = max((i for i, l in enumerate(lines) if re.match(r'^\S\s{3,}', l)), default=len(lines) - 1)
print(' '.join(lines[start:]))
PY
